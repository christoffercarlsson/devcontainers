FROM ghcr.io/christoffercarlsson/node@sha256:9b65b768e022bee915ef031da3d02f495d2cb294b4e59bccb2ac9794e99ed781 AS node-tools-builder

RUN npm install -g --ignore-scripts \
    bash-language-server \
    @earendil-works/pi-coding-agent \
    tombi

RUN npm install -g --allow-scripts=@anthropic-ai/claude-code @anthropic-ai/claude-code

FROM ghcr.io/christoffercarlsson/rust@sha256:93252e80151aa4a6875df2e2fc9c46038206bdaede8a8314a2bd9edb3303bfa6 AS rust-tools-builder

RUN cargo install --root /usr/local \
    bat \
    fd-find \
    jaq \
    proximity-sort \
    ripgrep \
    rumdl \
    tokei

FROM ghcr.io/christoffercarlsson/lua-language-server@sha256:147827be1a642c479b2e34e97ec2fc688ccfe922cdd29db8f690f82012effcd0 AS luals-builder

FROM ghcr.io/christoffercarlsson/debian-neovim@sha256:e4eb85326959fd0f73c46fd764c2548cc8cbeed2de86d5131376167e9798a6fe AS runtime

RUN export DEBIAN_FRONTEND=noninteractive \
    && rm -f /etc/dpkg/dpkg.cfg.d/docker \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        fish \
        fzf \
        git \
        gnupg \
        jq \
        less \
        man-db \
        manpages \
        manpages-dev \
        openssh-server \
        shfmt \
        stow \
        tmux \
        vim \
        zsh \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/entrypoint /usr/local/sbin/entrypoint
COPY configs/sshd.conf /etc/ssh/sshd_config.d/devcontainer.conf

COPY --from=node-tools-builder /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=node-tools-builder /usr/local/bin /usr/local/bin

COPY --from=rust-tools-builder /usr/local/bin/ /usr/local/bin/

COPY --from=luals-builder /opt/lua-language-server /opt/lua-language-server
COPY --from=luals-builder /usr/local/bin/lua-language-server /usr/local/bin/lua-language-server

RUN groupadd --gid 1000 dev \
    && useradd --uid 1000 --gid dev --shell /bin/zsh --create-home dev \
    && install -o dev -g dev -d /workspace

USER dev
WORKDIR /home/dev

COPY --chown=dev:dev scripts/bash /home/dev/.bash.local
COPY --chown=dev:dev scripts/fish /home/dev/.fish.local
COPY --chown=dev:dev scripts/zsh /home/dev/.zsh.local

RUN rm .bashrc

RUN git clone https://github.com/christoffercarlsson/dotfiles .dotfiles \
    && cd .dotfiles \
    && stow bash \
        biome \
        claude \
        fish \
        git \
        neovim \
        pi \
        rumdl \
        scripts \
        tmux \
        vim \
        zsh

USER root
WORKDIR /workspace

EXPOSE 22

ENTRYPOINT ["/usr/local/sbin/entrypoint"]

LABEL org.opencontainers.image.source=https://github.com/christoffercarlsson/devcontainers
